# syntax=docker/dockerfile:1.6
###############################################################################
# PaiSmart Frontend - Multi-stage Dockerfile
# Stage 1 : pnpm install + vite build
# Stage 2 : Nginx alpine + built dist + custom nginx.conf + gzip + brotli
###############################################################################

# =========================
# Stage 1: Builder (Node 20 + pnpm 8)
# =========================
FROM node:20-alpine AS builder

ARG PNPM_VERSION=8.15.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

# Copy workspace config + root package.json first
COPY frontend/pnpm-workspace.yaml ./
COPY frontend/package.json ./
COPY frontend/.npmrc ./

# Copy all packages' package.json (layer cache)
COPY frontend/packages ./packages
RUN for d in packages/*/; do mkdir -p "$d/src"; done
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=paismart-pnpm \
    pnpm install --frozen-lockfile --no-frozen-lockfile=false || pnpm install

# Now copy the rest of source
COPY frontend/ ./

# Build for production (mode=prod reads .env.prod)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=paismart-pnpm \
    pnpm typecheck && \
    pnpm build

# =========================
# Stage 2: Nginx runtime (brotli + gzip precompressed)
# =========================
FROM nginx:1.31-alpine AS runtime

# Brotli static module pre-built (optional - use standard nginx + gzip for simplicity)
RUN apk add --no-cache ca-certificates tzdata curl brotli && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# Non-root compatible: bind to 8080 instead of 80 (OpenShift compliant)
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html /etc/nginx/conf.d

# Copy build output
COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html

# Pre-compress static assets for gzip + brotli (faster transfer, zero runtime cost)
RUN cd /usr/share/nginx/html && \
    find . -type f \( -name "*.html" -o -name "*.js" -o -name "*.css" -o -name "*.svg" -o -name "*.json" -o -name "*.ico" \) \
    -exec sh -c 'gzip -kf9 "$1" && brotli -kf9 "$1"' _ {} \;

# Copy Kustomize/ConfigMap-mounted nginx.conf will be loaded; also bake default fallback
COPY --chown=nginx:nginx k8s/base/frontend/nginx.conf /etc/nginx/templates/default.conf.template

USER nginx:nginx

ENV TZ=Asia/Shanghai
ENV BACKEND_UPSTREAM=http://paismart-backend.paismart.svc.cluster.local:8080

EXPOSE 8080 8443

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS -o /dev/null http://127.0.0.1:8080/favicon.svg || exit 1

CMD [ "/bin/sh", "-c", "envsubst '$BACKEND_UPSTREAM' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'" ]
